{
  "name": "atlas-scholarly-sources-mcp",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "node scripts/build-info.mjs && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run build",
    "deploy": "npm run verify && wrangler deploy",
    "live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.152.0"
  }
}
